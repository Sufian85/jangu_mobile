    "title": "PlayStation 4 Slim 500GB Gold Edition",
    "slug": "playstation-4-slim-500gb-gold-edition",
    "category": [
      "gaming-gear"
    ],
    "description": "The slimmer, quieter PS4 in a limited-edition gold finish, with a matching gold DualShock 4 controller in the box. 500GB of storage, HDR support, Wi-Fi and Bluetooth, and access to thousands of PS4 games plus streaming apps such as Netflix and YouTube.",
    "brand": "Sony",
    "is_active": true,
    "created_at": "2026-10-25T04:58:51.339Z"
  }
},
{
  "model": "catalogue.product",
  "fields": {
    "title": "Xbox Wireless Controller",
    "slug": "xbox-wireless-controller",
    "category": [
      "gaming-gear"
    ],
    "description": "The standard Xbox controller, compatible with Xbox Series X|S, Xbox One, Windows PCs, Android and iOS. Textured grip on the triggers and bumpers, a hybrid D-pad, a Share button for screenshots and clips, a 3.5mm headset jack, and Bluetooth for wireless play on PC and phone. Runs on two AA batteries for up to 40 hours.",
    "brand": "Microsoft",
    "is_active": true,
    "created_at": "2026-10-25T04:58:51.372Z"
  }
},
{
  "model": "catalogue.product",
  "fields": {
    "title": "Sony DualSense Wireless Controller",
    "slug": "sony-dualsense-wireless-controller",
    "category": [
      "gaming-gear"
    ],
    "description": "The PlayStation 5 controller, with haptic feedback and adaptive triggers that react to what happens in the game. Built-in microphone, 3.5mm headset jack, motion sensors, Create button and a rechargeable battery that charges over USB-C. Also works with PC over USB or Bluetooth.",
    "brand": "Sony",
    "is_active": true,
    "created_at": "2026-10-25T04:58:51.385Z"
  }
},
{
  "model": "catalogue.product",
  "fields": {
    "title": "Apple Watch Series 6",
    "slug": "apple-watch-series-6",
    "category": [
      "audio-wearables"
    ],
    "description": "Measures blood oxygen and takes an ECG from your wrist, alongside heart-rate alerts, sleep tracking and fall detection. Always-On Retina display, S6 chip, built-in GPS and water resistance to 50m for swimming. Up to 18 hours of battery life. Requires an iPhone.",
    "brand": "Apple",
    "is_active": true,
    "created_at": "2026-10-25T04:58:51.424Z"
  }
},
{
  "model": "catalogue.product",
  "fields": {
    "title": "JBL Flip 6",
    "slug": "jbl-flip-6",
    "category": [
      "audio-wearables"
    ],
    "description": "Portable Bluetooth speaker with JBL Pro Sound from a two-way system (racetrack woofer plus a separate tweeter) for deep bass and clear highs. IP67 waterproof and dustproof, up to 12 hours of playtime, USB-C charging, and PartyBoost to pair it with other compatible JBL speakers.",
    "brand": "JBL",
    "is_active": true,
    "created_at": "2026-10-25T04:58:51.441Z"
