    "slug": "logitech-m220-silent-wireless-mouse",
    "category": [
      "laptops-accessories"
    ],
    "description": "A compact wireless mouse with silent clicks: over 90% less click noise than a standard Logitech mouse. Plug-and-play USB nano receiver with a 10m range, an ambidextrous shape, and up to 18 months of battery life on a single AA battery.",
    "brand": "Logitech",
    "is_active": true,
    "created_at": "2026-10-25T04:58:51.455Z"
  }
},
{
  "model": "catalogue.product",
